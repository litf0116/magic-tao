# Matchfile for molitao_app iOS
# 用于管理 iOS 证书和 Provisioning Profiles

# Git 仓库地址 (用于存储加密的证书)
git_url("git@github.com:litf0116/molitao-ios-certs.git")

# Git 分支 (可选，默认为 master)
git_branch("master")

# 存储类型 (appstore, adhoc, development, enterprise)
storage_mode("git")

# Bundle Identifier
type("appstore")  # 可选值: appstore, adhoc, development, enterprise

# App Identifier
app_identifier(["com.molitao.molitaoApp"])

# Team ID
team_id("WX4RK78D62")

# 用户名 (Apple ID)
username("799849240@qq.com")

# 加密密码 (用于加密 Git 仓库中的证书)
# ⚠️ 重要: 请妥善保管此密码，丢失将无法解密证书
# 可以通过环境变量 MATCH_PASSWORD 设置，不要在此文件中明文存储
# match_password("YOUR_MATCH_PASSWORD")

# 强制刷新 Provisioning Profiles
force_for_new_devices(true)

# 是否在失败时重试
readonly(true)  # 设为 false 允许创建新证书
