    "subPackages": [
        {
            "root": "pages/chat",
            "name": "chat",
            "pages": [
                {
                    "path": "auction",
                    "style": { "navigationBarTitleText": "秒杀场" }
                },
                {
                    "path": "contacts",
                    "style": { "navigationBarTitleText": "联系人" }
                },
                {
                    "path": "groupChat",
                    "style": { "navigationBarTitleText": "群聊" }
                },
                {
                    "path": "index",
                    "style": { "navigationBarTitleText": "会话" }
                },
                {
                    "path": "privateChat",
                    "style": { "navigationBarTitleText": "私聊" }
                }
            ]
        },
        {
            "root": "pages/tradingPost",
            "name": "tradingPost",
            "pages": [
                {
                    "path": "index",
                    "style": { "navigationBarTitleText": "交易站" }
                },
                {
                    "path": "addPost",
                    "style": { "navigationBarTitleText": "发布帖子" }
                },
                {
                    "path": "postDetail",
                    "style": { "navigationBarTitleText": "帖子详情" }
                }
            ]
        },
        {
            "root": "pages/user",
            "name": "user",
            "pages": [
                {
                    "path": "auctionSuccessList",
                    "style": { "navigationBarTitleText": "成交记录" }
                },
                {
                    "path": "balanceLog",
                    "style": { "navigationBarTitleText": "余额明细", "enablePullDownRefresh": true }
                },
                {
                    "path": "depositLog",
                    "style": { "navigationBarTitleText": "魔力值明细", "enablePullDownRefresh": true }
                },
                {
                    "path": "info",
                    "style": { "navigationBarTitleText": "用户信息编辑" }
                },
                {
                    "path": "list",
                    "style": { "navigationBarTitleText": "用户列表", "enablePullDownRefresh": true }
                }
            ]
        },
        {
            "root": "pages/announce",
            "name": "announce",
            "pages": [
                {
                    "path": "list",
                    "style": { "navigationBarTitleText": "公告" }
                }
            ]
        }
    ]
}
