<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主题：透明主题 -->
    <style name="TranslucentTheme" parent="android:Theme.Translucent">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- DCloud 主题 -->
    <style name="DCloudTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- 应用主题 -->
    <style name="Theme.MolitaoApp" parent="android:Theme.Material.Light">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">#f4835a</item>
        <item name="android:navigationBarColor">#f4835a</item>
    </style>
</resources>